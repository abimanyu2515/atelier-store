# Neon Postgres connection string (use the pooled connection URL)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth — generate a secret with: npx auth secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL used by the auth client
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe — use a sandbox and a restricted key (rk_…) with write access to
# Checkout Sessions and read access to Charges and PaymentIntents.
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint (/api/stripe/webhook). Locally, the
# whsec_… printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=""

# Bearer token for /api/cron/release-orders (openssl rand -base64 32)
CRON_SECRET=""
